programa {
  funcao inicio() {
    //Declaração da Variável(criando a "caixa")
    cadeia nomeUsuario

    //ENTRADA: captura dados do usuário
    escreva("Digite seu nome:")
    leia(nomeUsuario)

    //SAÍDA:exibido o resultado
    escreva("Olá ", nomeUsuario)
  }
}
