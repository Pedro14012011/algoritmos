programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade

    nome = "Pedro S"
    pontos = 1500
    idade = 16
    escreva("Olá, mundo! \n")
    escreva( nome," tem ", idade, " de idade\n")
    escreva("Meu amigou ganhou ", pontos," e o outro amigo tem ", idade, " de idade e o meu nome e ", nome," e fim")
  }
}
